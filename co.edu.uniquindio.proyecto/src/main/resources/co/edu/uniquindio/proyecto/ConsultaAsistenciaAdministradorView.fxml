<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="700" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto.ViewController.AsistenciaAdministradorViewController">

    <children>
        <VBox spacing="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

            <!-- TÍTULO -->
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Validación de Entrada Avanzada" />

            <!-- CAMPO NOMBRE -->
            <HBox spacing="10">
                <children>
                    <Label text="Nombre:" />
                    <TextField fx:id="txtNombre" prefHeight="26.0" prefWidth="108.0" />
                    <Label prefHeight="18.0" prefWidth="73.0" text="Identificación:" />
                    <TextField fx:id="txtIdentificacion" prefHeight="26.0" prefWidth="108.0" />
                    <Label text="Teléfono:" />
                    <TextField fx:id="txtTelefono" prefHeight="26.0" prefWidth="108.0" />
                    <Button fx:id="btnValidar" onAction="#onActionValidar" text="Validar" />
                </children>
            </HBox>

            <!-- CAMPO IDENTIFICACIÓN -->
            <HBox spacing="10" />

            <!-- CAMPO TELÉFONO -->
            <HBox spacing="10" />

            <!-- BOTÓN VALIDAR -->
            <HBox spacing="10" />

            <!-- RESULTADO -->
            <VBox spacing="5">
                <children>
                    <Label text="Resultado:" />
                    <TextArea fx:id="txtResultado" prefHeight="200" />
                </children>
            </VBox>

        </VBox>
    </children>

</AnchorPane>
