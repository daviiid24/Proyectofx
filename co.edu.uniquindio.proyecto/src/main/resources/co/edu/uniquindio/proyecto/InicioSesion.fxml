<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyecto.ViewController.InicioSesionViewController">
    <children>
        <VBox alignment="CENTER" layoutX="100.0" layoutY="21.0" prefHeight="300.0" prefWidth="300.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label text="Sistema de Gimnasio" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Iniciar Sesión" textFill="#666666">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Usuario:" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Contraseña:" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="txtPassword" promptText="Ingrese su contraseña" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                    </children>
                </VBox>

                <Label fx:id="lblMensaje" textFill="red" visible="false">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>

                <Button fx:id="btnLogin" onAction="#onLoginClick" prefHeight="35.0" prefWidth="240.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="INGRESAR">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
