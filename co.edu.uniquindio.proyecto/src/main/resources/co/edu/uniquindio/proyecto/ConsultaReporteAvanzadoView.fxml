<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="520" prefWidth="720"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyecto.ViewController.CrudReporteAvanzadoViewController">

    <children>
        <VBox spacing="25"
              alignment="CENTER"
              AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="20"
              AnchorPane.topAnchor="20">

            <!-- TÍTULO -->
            <Label text="Consulta de Reporte Avanzado"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;" />

            <!-- CAMPO PARA INGRESAR ID REPORTE -->
            <HBox spacing="10" alignment="CENTER">
                <children>
                    <Label text="ID Reporte:" />
                    <TextField fx:id="txtIdReporte" prefWidth="250" />
                    <Button fx:id="btnBuscarReporte"
                            onAction="#onActionBuscarReporte"
                            text="Buscar" />
                </children>
            </HBox>

            <!-- RESULTADO -->
            <VBox spacing="8" alignment="CENTER">
                <children>
                    <Label text="Resultado del Reporte:" />
                    <TextArea fx:id="txtResultado"
                              prefHeight="330"
                              wrapText="true"
                              prefWidth="600"/>
                </children>
            </VBox>

        </VBox>
    </children>

</AnchorPane>
